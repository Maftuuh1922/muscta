rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow everything for authenticated users (dev only!)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

// WARNING: For production, restrict rules to only allow users to read/write their own data.
// Example:
// match /users/{userId} {
//   allow read, write: if request.auth != null && request.auth.uid == userId;
// }
